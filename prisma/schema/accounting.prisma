enum IntentStatus {
  ACTIVE // đang chờ thanh toán
  SUCCEEDED // thanh toán thành công
  FAILED // gateway báo fail
  EXPIRED // quá hạn
  CANCELLED // user hủy
}

model PaymentIntent {
  id         String          @id @default(uuid()) @db.Uuid
  gatewayRef String?         @unique
  status     IntentStatus
  provider   PaymentProvider
  orderIds   Json
  amount     Decimal
  currency   Currency?
  expiresAt  DateTime
  createdAt  DateTime        @default(now())

  @@map("payment_intent")
}

model LedgerEntry {
  id            String          @id @default(uuid()) @db.Uuid
  walletId      String          @db.Uuid
  walletType    WalletType      @default(SHOP)
  amount        Decimal         @db.Decimal(19, 4)
  direction     LedgerDirection // CREDIT hoặc DEBIT
  balanceBefore Decimal         @default(0) @db.Decimal(19, 4)
  balanceAfter  Decimal         @default(0) @db.Decimal(19, 4)
  type          LedgerType
  description   String?

  transactionGroup String?
  idempotencyKey   String? @unique
  paymentId        String? @db.Uuid
  orderId          String? @db.Uuid

  createdAt DateTime @default(now())
  Shop      Shop?    @relation(fields: [shopId], references: [id])
  shopId    String?  @db.Uuid

  @@index([walletId, createdAt])
  @@index([type])
  @@index([orderId])
  @@index([paymentId])
  @@index([transactionGroup])
}

model ShopBalance {
  shopId    String   @id @db.Uuid
  pending   Decimal  @default(0) @db.Decimal(19, 4) // Tiền đang chờ xử lý (ví dụ: khách đã trả nhưng chưa nhận hàng)
  available Decimal  @default(0) @db.Decimal(19, 4) // Tiền có thể rút/tiêu
  frozen    Decimal  @default(0) @db.Decimal(19, 4) // Tiền đang bị đóng băng (ví dụ: đang yêu cầu rút)
  version   Int      @default(0) // Dùng cho Optimistic Locking
  updatedAt DateTime @updatedAt
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
}

enum SettleStatus {
  PENDING
  PROCESSED
  CANCELLED
}

model SettlementQueue {
  id      String  @id @default(uuid())
  shopId  String
  orderId String  @unique // 1 đơn 1 lần trả
  amount  Decimal @db.Decimal(19, 4)

  feeAmount Decimal @default(0) @db.Decimal(19, 4)
  netAmount Decimal @default(0) @db.Decimal(19, 4) // Số thực nhận = amount - fee

  status SettleStatus // PENDING, PROCESSED, CANCELLED
  dueAt  DateTime // Ngày đến hạn (settleDate)

  retryCount Int     @default(0)
  failReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, dueAt])
}

enum PayoutStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  REJECTED
}

model PayoutRequest {
  id     String       @id @default(uuid())
  shopId String       @db.Uuid
  amount Decimal      @db.Decimal(19, 4)
  status PayoutStatus // REQUESTED, PROCESSING, COMPLETED, REJECTED

  bankInfo Json // Thông tin TK ngân hàng nhận tiền
  txRef    String? // Mã tham chiếu chuyển khoản ngân hàng

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
