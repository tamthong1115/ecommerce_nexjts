model LedgerEntry {
  id               String          @id @default(uuid()) @db.Uuid
  walletId         String          @db.Uuid
  walletType       WalletType      @default(SHOP)
  amount           Decimal         @db.Decimal(19, 4)
  direction        LedgerDirection
  balanceBefore    Decimal         @default(0) @db.Decimal(19, 4)
  balanceAfter     Decimal         @default(0) @db.Decimal(19, 4)
  type             LedgerType
  description      String?
  transactionGroup String?
  paymentId        String?         @db.Uuid
  orderId          String?         @db.Uuid
  createdAt        DateTime        @default(now())
  shopId           String?         @db.Uuid
  Shop             Shop?           @relation(fields: [shopId], references: [id])

  @@index([walletId, createdAt])
  @@index([type])
  @@index([orderId])
  @@index([paymentId])
  @@index([transactionGroup])
}

model SettlementQueue {
  id         String       @id @default(uuid())
  shopId     String
  orderId    String       @unique
  amount     Decimal      @db.Decimal(19, 4)
  feeAmount  Decimal      @default(0) @db.Decimal(19, 4)
  netAmount  Decimal      @default(0) @db.Decimal(19, 4)
  status     SettleStatus
  dueAt      DateTime
  retryCount Int          @default(0)
  failReason String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([status, dueAt])
  @@map("settlement_queue")
}

model PayoutRequest {
  id        String       @id @default(uuid())
  shopId    String       @db.Uuid
  amount    Decimal      @db.Decimal(19, 4)
  status    PayoutStatus
  bankInfo  Json
  txRef     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([shopId, status])
  @@map("payout_request")
}

enum LedgerDirection {
  CREDIT
  DEBIT
}

enum WalletType {
  SHOP
  USER
  PLATFORM
}

enum LedgerType {
  ORDER_PAID
  VOUCHER_SUBSIDY
  ADJUSTMENT_IN
  PLATFORM_FEE
  SHIPPING_FEE
  PAYOUT
  SETTLEMENT
  REFUND
  ADJUSTMENT_OUT
}

enum IntentStatus {
  ACTIVE
  SUCCEEDED
  FAILED
  EXPIRED
  CANCELLED
}

enum SettleStatus {
  PENDING
  PROCESSED
  CANCELLED
}

enum PayoutStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  REJECTED
}
