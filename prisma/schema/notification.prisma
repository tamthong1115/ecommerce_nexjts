enum NotificationType {
  SYSTEM
  SECURITY
  VERIFICATION
  MAINTENANCE

  ORDER_CREATED
  ORDER_CONFIRMED
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_CANCELLED

  PAYMENT_SUCCESS
  PAYMENT_FAILED
  REFUND_PROCESSED
  PAYOUT_COMPLETED

  REVIEW_RECEIVED
  QUESTION_ANSWERED
  MESSAGE

  SHOP_ACTIVITY
  INVENTORY_LOW

  PROMOTION
  WISHLIST_PRICE_DROP
  ABANDONED_CART
}

enum NotificationRole {
  BUYER
  SELLER
  ADMIN
  SUPPORT
}

model Notification {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String           @db.Uuid
  recipientRole NotificationRole @default(BUYER)
  type          NotificationType

  referenceId   String?
  referenceType String?

  title    String
  body     String
  image    String?
  metadata Json?

  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recipientRole, isRead])
  @@index([createdAt])
  @@map("notification")
}
